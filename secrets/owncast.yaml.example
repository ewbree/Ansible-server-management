
### Owncast specific:
owncast_target: "abc"
owncast_instances:  # Refer to instance during script runtime with setting 'owncast_target' to the corresponding 'owncast_name'
  - owncast_name: "abc"
    owncast_domain: "live.abc.tld"
    owncast_https_proxy_port: 00000
    owncast_rtmp_port: 00000
  - owncast_name: "xyz"
    owncast_domain: "live.xyz.tld"
    owncast_https_proxy_port: 00000
    owncast_rtmp_port: 00000
