
# Ports published on the host, format "host:container/protocol". Port 443 is left out by default as Apache uses it.
softether_ports:
  - "5555:5555/tcp"  # SoftEther protocol and admin console (vendor recommended)
  - "1194:1194/udp"  # OpenVPN
  - "500:500/udp"    # L2TP/IPsec
  - "4500:4500/udp"  # L2TP/IPsec NAT-T
  - "1701:1701/tcp"  # L2TP

softether_hub_name: "DEFAULT"
softether_dhcp_start: "192.168.243.11"
softether_dhcp_end: "192.168.243.50"
softether_dhcp_mask: "255.255.255.0"

### SoftEther
softether_server_password: "<username>"
softether_hub_password: "<password>"
softether_psk: "<very secure PSK>"
softether_users:
  - username: "user1"
    password: "<password>"
  - username: "user2"
    password: "<password>"
